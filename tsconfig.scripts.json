{
	// Type-check the TypeScript under `scripts/`.
	//
	// These are developer tools that import main-process modules, so they need the
	// main config's options - but not its `rootDir`/`outDir`, which exist to emit
	// the app. Checked only, and kept out of tsconfig.main.json so a harness can
	// never end up in a build.
	"extends": "./tsconfig.main.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "."
	},
	// The ambient module declarations ride along: a script that reaches a
	// main-process module which imports an untyped package needs them too.
	"include": ["scripts/**/*.ts", "src/types/**/*.d.ts"],
	// The Grok qualification harness came from rc, which never type-checked it.
	// It imports renderer modules (contextExtractor reaches the renderer stores,
	// WizardContext.tsx, tokenCounter's import.meta), which this Node config
	// cannot check without DOM, JSX and ESM settings. With those it is clean.
	"exclude": ["node_modules", "dist", "release", "scripts/grok-qualification/**"]
}
