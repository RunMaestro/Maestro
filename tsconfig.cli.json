{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020"],
		"module": "CommonJS",
		"moduleResolution": "node",
		// TODO(ts7): migrate moduleResolution from "node" (alias for "node10")
		// to "node16" or "bundler" before TypeScript 7. ignoreDeprecations
		// silences the warning under TS 6 but stops working in TS 7.
		"ignoreDeprecations": "6.0",
		"outDir": "dist/cli",
		"rootDir": "src",
		// Same shim as tsconfig.main.json: @opencode-ai/sdk exposes its types only
		// through the "exports" map, which node10 resolution cannot read, and the
		// standalone Cue engine reaches src/main/process-manager, which imports it.
		"paths": {
			"@opencode-ai/sdk": ["./node_modules/@opencode-ai/sdk/dist/index.d.ts"]
		},
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"declaration": false,
		"sourceMap": true
	},
	// CLI uses shared types, prompts for auto-run synopsis, and types for module declarations
	"include": [
		"src/cli/**/*",
		"src/maestro-p/**/*",
		"src/shared/**/*",
		"src/prompts/**/*",
		"src/types/**/*"
	],
	"exclude": ["node_modules", "dist", "release"]
}
